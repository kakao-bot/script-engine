pub async fn on_message(msg) {
    if msg.text == "핑" {
        msg.say("퐁").await?;
    }

    if msg.text == "하트" {
        msg.react(bot::HEART).await?;
    }

    if msg.text == "나중에" {
        bot::spawn(async {
            time::sleep(time::Duration::from_secs(5)).await;
            msg.say("5초 지났다").await?;
        })?;
    }

    if msg.text.starts_with("!eval ") {
        let code = msg.text["!eval ".len()..];
        msg.say(bot::eval(msg, code).await).await?;
    }
}
