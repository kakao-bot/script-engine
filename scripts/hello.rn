pub async fn on_message(msg) {
    if msg.text == "핑" {
        msg.say("퐁").await?;
    }

    if msg.text == "하트" {
        msg.react(bot::HEART).await?;
    }

    if msg.text == "나중에" {
        bot::spawn(async {
            time::sleep(time::Duration::from_secs(5)).await;
            msg.say("5초 지났다").await?;
        })?;
    }

    if msg.text == "방" {
        let rooms = msg.chat.session().chats().await?;
        msg.say(`방 ${rooms.len()}개`).await?;
    }

    if msg.text.starts_with("!eval ") {
        let code = msg.text["!eval ".len()..];
        msg.say(bot::eval(msg, code).await).await?;
    }
}

pub async fn on_join(chat, members) {
    for member in members {
        chat.write(`${member.display}님 어서오세요`).await?;
    }
}

pub async fn on_leave(chat, members) {
    for member in members {
        chat.write(`${member.display}님 안녕히`).await?;
    }
}

pub async fn on_member_change(chat, joined, members) {
    for member in members {
        println(`멤버 ${if joined { "입장" } else { "퇴장" }}: ${member.display} (${chat.id})`);
    }
}

pub async fn on_read(chat, user_id, watermark) {
    println(`읽음: ${user_id} → ${watermark} (${chat.id})`);
}

pub async fn on_reaction(chat, log_id, meta_type, content) {
    println(`반응: log ${log_id} type ${meta_type} ${content}`);
}

pub async fn on_feed(chat, feed_type) {
    println(`피드 ${feed_type} (${chat.id})`);
}

pub async fn on_meta_change(chat_id, meta_type, content) {
    println(`메타 ${meta_type} (${chat_id}) ${content}`);
}

pub async fn on_left(chat) {
    println(`나간 방 ${chat.id}`);
}

pub async fn on_sync_join(chat) {
    println(`다른 기기에서 입장 ${chat.id}`);
}

pub async fn on_link_profile(chat, link_id) {
    println(`프로필 변경 link ${link_id} (${chat.id})`);
}

pub async fn on_login(user_id) {
    println(`로그인 ${user_id}`);
}

pub async fn on_listening(seconds) {
    println(`대기 시작, 핑 ${seconds}초`);
}

pub async fn on_kicked() {
    println("다른 기기에 밀려남");
}

pub async fn on_moved(method) {
    println(`서버 이동 ${method}`);
}

pub async fn on_push(method) {
    println(`푸시 ${method}`);
}

pub async fn on_connect() {
    println("연결됨");
}

pub async fn on_close(reason) {
    println(`종료 ${reason}`);
}
